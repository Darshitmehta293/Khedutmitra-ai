# KhedutMitra AI — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://khedut:khedut123@localhost:5432/khedutmitra
SYNC_DATABASE_URL=postgresql://khedut:khedut123@localhost:5432/khedutmitra

# ─── Security ───────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# ─── IBM Granite / watsonx.ai ───────────────────────────────
IBM_API_KEY=your-ibm-cloud-api-key
IBM_PROJECT_ID=your-watsonx-project-id
IBM_GRANITE_ENDPOINT=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# ─── IBM Cloud Object Storage ───────────────────────────────
COS_API_KEY=your-cos-api-key
COS_INSTANCE_ID=your-cos-instance-id
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=khedutmitra-images

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App Config ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── Market Data ────────────────────────────────────────────
MARKET_DATA_PROVIDER=mock
# Options: mock | live
LIVE_MARKET_DATA_API_URL=
LIVE_MARKET_DATA_API_KEY=

# ─── Feature Flags ──────────────────────────────────────────
ENABLE_QUALITY_AI=false
ENABLE_LIVE_MARKET_DATA=false
DEMO_MODE=true
